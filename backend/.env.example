# PostgreSQL connection string (Neon, Railway, Render, or local Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/sharma_furniture_house?schema=public"

# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Admin bootstrap (used only by prisma/seed.ts to create the first admin user)
ADMIN_EMAIL="admin@sharmafurniturehouse.com"
ADMIN_PASSWORD="ChangeThisPassword123!"
ADMIN_NAME="Dhananjay Sharma"

# Cloudinary (image storage)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# CORS - comma separated list of allowed origins
CORS_ORIGIN="http://localhost:3000"
